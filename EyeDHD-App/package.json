{
  "name": "sight-app",
  "productName": "sight",
  "author": "SIGHT",
  "description": "A desktop application for analyzing eye-tracking data.",
  "version": "0.0.0",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run rebuild:electron && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "format": "prettier --write .",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3",
    "rebuild:test": "npm rebuild -o better-sqlite3",
    "test": "npm run rebuild:test && vitest run"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@types/react-router": "^5.1.20",
    "@types/redux": "^3.6.31",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "electron": "40.2.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@reduxjs/toolkit": "^2.11.2",
    "apexcharts": "^5.3.6",
    "better-sqlite3": "^12.4.1",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "skia-canvas": "^3.0.8",
    "three": "^0.183.2"
  }
}
