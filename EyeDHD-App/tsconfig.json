{
	"compilerOptions": {
		"target": "ESNext",
		"module": "commonjs",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"sourceMap": true,
		"baseUrl": ".",
		"outDir": "dist",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"paths": {
			"@src/*": ["src/*"],
			"@electron/*": ["electron/*"],
			"@saccades/*": ["saccades/*"],
			"@viz/*": ["viz/*"]
		}
	},
	"include": ["src/**/*", "electron/**/*", "saccades/**/*", "viz/**/*"],
	"files": [
		"src/global.d.ts",
		"forge.env.d.ts",
		".eslintrc.cjs",
		"vite.aliases.ts",
		"vite.main.config.ts",
		"vite.preload.config.ts",
		"vite.renderer.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", "dist", ".vite"]
}
