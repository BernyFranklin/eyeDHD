{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "lib": ["ES6", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "rootDir": "./",
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "electron/**/*",
    "saccades/**/*",
    "vite-env.d.ts",
    "./**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
